CONFIG_TARGET_ath79=y
CONFIG_TARGET_ath79_generic=y
CONFIG_TARGET_ath79_generic_DEVICE_tplink_archer-c60-v2=y

# Веб-интерфейс LuCI и русский язык
CONFIG_PACKAGE_luci=y
CONFIG_PACKAGE_luci-ssl=y
CONFIG_PACKAGE_luci-i18n-base-ru=y
CONFIG_PACKAGE_luci-i18n-firewall-ru=y
CONFIG_PACKAGE_luci-i18n-opkg-ru=y

# Поддержка WireGuard (в т.ч. для Cloudflare WARP / VPN)
CONFIG_PACKAGE_wireguard-tools=y
CONFIG_PACKAGE_kmod-wireguard=y
CONFIG_PACKAGE_luci-proto-wireguard=y

# Полезные утилиты
CONFIG_PACKAGE_curl=y
CONFIG_PACKAGE_nano=y
CONFIG_PACKAGE_htop=y

# Экономия дефицитной ОЗУ (64 МБ) для стабильной работы 5 ГГц Wi-Fi
CONFIG_PACKAGE_kmod-ath10k-ct-smallbuffers=y
# CONFIG_PACKAGE_kmod-ath10k-ct is not set
